# picopi credentials — TEMPLATE.
#
# Copy this file to `credentials.toml` in the same directory and fill in the
# real values:
#
#     cp secrets/credentials.toml.example secrets/credentials.toml
#
# `credentials.toml` is gitignored and must NEVER be committed. This example
# file is safe to commit and contains placeholders only.
#
# A project's build.rs finds this file (see pico-template/README.md for the
# search order) and parses it at BUILD time, baking the values into the
# firmware — nothing is read from disk at runtime.

[wifi]
ssid     = "Beacon"
password = "change-me"
# Optional: ISO 3166-1 alpha-2 country code, for the cyw43 CLM/regulatory
# configuration. Leave empty if unsure.
country  = "SE"

# Add more blocks as the projects grow, e.g.:
#
# [api]
# token = "..."
#
# Each block/key is available to build.rs; add a matching constant in
# pico-template/build.rs when you start using one.
